# Go BFF origin (services/web, default :18080 in local dev)
NEXT_PUBLIC_BFF_ORIGIN=http://localhost:18080

# To use the real BFF through the Next.js same-origin proxy:
# NEXT_PUBLIC_PROTOTYPE_MODE=external
# NEXT_PUBLIC_BFF_ORIGIN=https://app.vexynix.com

# Sandbox payment button. On by default in `next dev`: when a deposit lands on
# the SANDBOX gateway, the payment screen shows a button that completes it with
# no real transfer (via the BFF's WEB_ALLOW_SANDBOX_SETTLE route). Production
# builds strip it regardless; set to 0 to hide it in dev too.
# NEXT_PUBLIC_DEV_SIMULATE_PAYMENT=0

