    "datatables.net-buttons-bs5": "^3.2.4",
    "datatables.net-fixedcolumns-bs5": "^5.0.4",
    "datatables.net-react": "^1.0.1",
    "datatables.net-responsive-bs5": "^3.0.5",
    "flag-icons": "^7.5.0",
    "jquery": "^3.7.1",
    "jsvectormap": "^1.7.0",
    "lity": "^2.4.1",
    "masonry-layout": "^4.2.2",
    "next": "15.3.8",
    "photoswipe": "^5.4.4",
    "quill": "^2.0.3",
    "react": "^19.1.0",
    "react-apexcharts": "^1.7.0",
    "react-bootstrap-daterangepicker": "^8.0.0",
    "react-color": "^2.19.3",
    "react-countdown": "^2.3.6",
