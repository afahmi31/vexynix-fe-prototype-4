    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react-datepicker": {
      "react": ">=19.0.0",
      "react-dom": ">=19.0.0"
    },
    "react-notifications-component": {
      "react": ">=19.0.0",
      "react-dom": ">=19.0.0"
    },
    "react-tag-input-component": {
      "react": ">=19.0.0",
      "react-dom": ">=19.0.0"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
