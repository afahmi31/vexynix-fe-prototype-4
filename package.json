{
  "name": "game-web-client-facing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "next dev",
    "dev:up": "bash scripts/dev.sh",
    "dev:down": "bash scripts/dev.sh stop",
    "mock-bff": "node scripts/mock-bff.js",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:check-bundle": "next build && bash scripts/check-bundle-size.sh",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,css}\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
