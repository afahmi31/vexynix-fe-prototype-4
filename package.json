    "recharts": "^3.10.1",
    "sass": "1.77.7",
    "simple-line-icons": "^2.5.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bootstrap": "^5.2.10",
