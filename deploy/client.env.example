# Runtime env for the frontend container (injected into public/__ENV.js at start).
# Copy to deploy/client.env on the server. NONE of these are secrets — the browser
# reaches the BFF same-origin via Traefik, so BFF_ORIGIN only matters for SSR
# (currently unused) and as a documented default.
#
#   cp deploy/client.env.example deploy/client.env   # then edit on the server

# BFF origin for any SERVER-SIDE fetch. Browser calls are same-origin (relative), which is
# what makes one container serve every brand: the page fetches `/api/...` on whatever
# `app.<domain>` the player arrived at, and the BFF resolves Host -> tenant from there
# (game-docs/11 §5).
#
# ⚠️ It must NOT name a brand's public host. Pointing it at `https://app.vexynix.com` pins
# every server-side fetch to ONE brand — the operator's own — which is exactly the
# hand-wiring the managed-domain model removed. Point it at the BFF on the compose network.
BFF_ORIGIN=http://web:8080

# Environment label surfaced to the client (window.__ENV.APP_ENV).
APP_ENV=staging

# Optional comma-separated feature flags. Leave empty if unused.
FEATURE_FLAGS=
